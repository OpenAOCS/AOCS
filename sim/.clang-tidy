Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  performance-*,
  modernize-use-emplace,
  modernize-use-equals-default,
  modernize-use-equals-delete,
  modernize-use-nullptr,
  modernize-use-override
WarningsAsErrors: ''
HeaderFilterRegex: '.*(/sim/|/shared/(astro|bindings|math)/|/shared/(ipc|aocs_to_sim|sim_to_aocs)\.hpp).*'
FormatStyle: file
